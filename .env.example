# --- Database -----------------------------------------------------------------
# PostgreSQL 15+. Local by default; a hosted instance works unchanged.
# URL-encode special characters in the password: @ is %40, # is %23, / is %2F.
DATABASE_URL=postgresql://postgres:<PASSWORD>@localhost:5432/crystal_procurement

# Same connection, used by the migration runner. On a hosted database that puts
# a transaction pooler in front (Supabase and similar), this must be the DIRECT
# port — DDL does not work through a pooler.
DIRECT_URL=postgresql://postgres:<PASSWORD>@localhost:5432/crystal_procurement

# The maintenance database. Used only by `npm run db:create` and `verify:db`,
# which need to CREATE and DROP databases.
ADMIN_URL=postgresql://postgres:<PASSWORD>@localhost:5432/postgres

# --- Authentication -----------------------------------------------------------
# 'local' = sign in by picking a user at /signin. DEVELOPMENT ONLY — there is no
#           password, so anyone who can reach the server can be anyone. Refused
#           in a production build unless ALLOW_LOCAL_AUTH=1 is set on purpose.
# 'core'  = Crystal Core SSO. A launch token is verified with Core before any
#           session exists. This is the production path.
AUTH_MODE=local

# Only used when AUTH_MODE=core.
CRYSTAL_CORE_URL=https://crystal-core-official-version.vercel.app

# HMAC key for the signed session cookie (>= 32 random chars).
# Rotating it signs everyone out.
SESSION_SECRET=

# Shared secret Crystal Core sends as x-sync-secret when pushing role changes.
CORE_SYNC_SECRET=

# --- Application encryption ---------------------------------------------------
# AES-256-GCM key for vendor bank account numbers (vendor_bank_accounts.
# account_number_enc). 32 bytes, base64:  openssl rand -base64 32
#
# Losing this makes every stored account number unreadable. The last four
# digits and the IFSC survive; the full number does not. Keep it somewhere
# durable before this carries real vendors.
BANK_ENC_KEY=

# Documents are written here. A container mounts a volume at this path.
DOCUMENT_STORE=.documents

# Virus scanning: "require" refuses to serve an unscanned file. Unset serves it.
# SCAN_MODE=require

# Mail transport for the outbox drain: log | noop | fail
MAIL_TRANSPORT=log

# --- Development shortcuts ----------------------------------------------------
# OPEN_APPROVALS=1 lets ANY role at a site take ANY decision there, so a test
# chain does not stall waiting for the one account that holds CG_FHEAD.
#
# It cannot open approving your own work: mr_self_approval, rtv_self_approval
# and vba_maker_checker are database CHECK constraints, plus two triggers.
#
# Ignored unless local sign-in is available, so it can never take effect against
# Crystal Core. Leave it unset anywhere real.
# OPEN_APPROVALS=1
